# 复制为 .env 后按实际环境填写。严禁将真实密钥、模型权重或业务数据提交到 Git。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO

# PostgreSQL 业务元数据与向量存储配置
POSTGRES_DB=localpatentai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
PGHOST=127.0.0.1
PGPORT=5432
DATABASE_URL=postgresql+psycopg://postgres:changeme@127.0.0.1:5432/localpatentai
DATA_ROOT=./data/workspaces
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts

# 本地 Qwen + vLLM 服务（openai_compatible | mock）
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen3.8-27B-FP8
LLM_API_KEY=local-only-placeholder
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# 本地 BGE Embedding（local | openai_compatible | mock）
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_PATH=/data/zch/workspace/LocalPatentAI/models/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# 本地 BGE Reranker（local | mock）
RERANKER_BACKEND=local
RERANKER_ENABLED=true
RERANKER_MODEL_PATH=/data/zch/workspace/LocalPatentAI/models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# 向量与混合检索配置（pgvector | qdrant | memory）
VECTOR_STORE_BACKEND=pgvector
QDRANT_URL=http://127.0.0.1:6333
BM25_BACKEND=local
DENSE_TOP_K=30
BM25_TOP_K=30
RRF_K=60
RERANKER_TOP_N=8
MAX_RETRIEVAL_CANDIDATES=50

# 工作流预算与限制
MAX_REVISION_ROUNDS=2
MAX_LLM_CALLS_PER_TASK=30
NODE_TIMEOUT_SECONDS=120
TASK_TIMEOUT_SECONDS=1800
MAX_CONTEXT_TOKENS=4096
MAX_UPLOAD_SIZE_MB=100

# 严禁开启外部遥测
ENABLE_EXTERNAL_TELEMETRY=false
